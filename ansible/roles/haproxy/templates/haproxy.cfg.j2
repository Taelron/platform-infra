# {{ ansible_managed }}
# HAProxy on platform-aws-01: the public path from the load balancer, and the
# Rancher agents' path from the clusters.

global
  log stdout format raw local0
  chroot /var/lib/haproxy
  user haproxy
  group haproxy
  maxconn 4000
  ssl-default-bind-options ssl-min-ver TLSv1.2
  ssl-default-server-options ssl-min-ver TLSv1.2

defaults
  log global
  timeout connect 5s
  timeout client 60s
  timeout server 60s
  timeout tunnel 1h

# From the load balancer only (flow 1).
frontend fe_public
  mode http
  option httplog
  bind {{ host_vpc_address }}:443 ssl crt /etc/haproxy/certs/host.pem alpn h2,http/1.1
  http-request set-header X-Forwarded-Proto https

  # The load balancer's health check asks for the target's own address.
  acl is_health hdr(host) -m str {{ host_vpc_address }} {{ host_vpc_address }}:443
  use_backend be_health if is_health

{% for r in haproxy_routes %}
{% if r.hosts is defined %}
  use_backend be_{{ r.name }} if { req.hdr(host),field(1,:) -m str {{ r.hosts | join(' ') }} }
{% else %}
  use_backend be_{{ r.name }} if { req.hdr(host),field(1,:) -m end {{ r.domain }} }
{% endif %}
{% endfor %}
  default_backend be_unknown

backend be_health
  mode http
  http-request return status 200 content-type text/plain string "ok"

backend be_unknown
  mode http
  http-request return status 404 content-type text/plain string "unknown name"

{% for r in haproxy_routes %}
backend be_{{ r.name }}
  mode http
  # Checked every 10 seconds, so a name whose backend is down answers 503 at once.
  server {{ r.name }} {{ r.server }} ssl verify none sni req.hdr(host),field(1,:) check check-sni {{ r.hosts[0] if r.hosts is defined else ('check' ~ r.domain) }} inter 10s fall 2 rise 1

{% endfor %}
# Rancher agents from the clusters (flow 5), passed through over TCP.
frontend fe_rancher_agents
  mode tcp
  option tcplog
  bind {{ rancher_address }}:443
  default_backend be_rancher_agents

backend be_rancher_agents
  mode tcp
  server rancher {{ haproxy_rancher_agents_backend }}

frontend fe_metrics
  mode http
  bind {{ haproxy_metrics_bind }}
  http-request use-service prometheus-exporter if { path /metrics }
  http-request return status 404
