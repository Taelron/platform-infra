# {{ ansible_managed }}
# TYPE    DATABASE  USER      ADDRESS   METHOD
# The postgres superuser only through the local socket, as the postgres user.
local     all       postgres            peer

{% for d in postgresql_databases %}
# {{ d.name }}
{% for src in d.from %}
{% if src in postgresql_host_sources %}
host      {{ d.name }}  {{ d.name }}  {{ src }}  scram-sha-256
{% else %}
hostssl   {{ d.name }}  {{ d.name }}  {{ src }}  scram-sha-256
{% endif %}
{% endfor %}
{% endfor %}
