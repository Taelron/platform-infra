# {{ ansible_managed }}
# TYPE    DATABASE  USER      ADDRESS   METHOD
# The postgres superuser only through the local socket, as the postgres user.
local     all       postgres            peer

{% for d in postgresql_databases + postgresql_reader_roles %}
{% set db = d.database | default(d.name) %}
# {{ d.name }}
{% for src in d.from %}
{% if src in postgresql_host_sources %}
host      {{ db }}  {{ d.name }}  {{ src }}  scram-sha-256
{% else %}
hostssl   {{ db }}  {{ d.name }}  {{ src }}  scram-sha-256
{% endif %}
{% endfor %}
{% endfor %}
